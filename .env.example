# Copy to .env before starting.

# Security / app
ADMIN_API_KEY=change-this-admin-key
NEXT_PUBLIC_ADMIN_API_KEY=change-this-admin-key
CORS_ORIGINS=http://localhost:3000

# LLM: any OpenAI-compatible endpoint can be used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

# Voice cloning / TTS provider.
# ElevenLabs is the default implementation in this MVP.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: if a client has already been assigned a cloned voice,
# put the provider voice ID in the client's Settings > Voice.

# Database is supplied by docker-compose.
DATABASE_URL=postgresql+psycopg2://executive:executive_password@db:5432/executive_ai
REDIS_URL=redis://redis:6379/0

# Neo4j graph memory
NEO4J_PASSWORD=change-this-neo4j-password
